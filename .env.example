# NSAT AI Configuration Example
# Set to 'false' to disable AI reasoning layer and run 100% deterministic
AI_ENABLED=true

# GLM-5.3 Provider Configuration
# Set the API key provided by your host platform (e.g., NVIDIA NIM, Zhipu AI, OpenAI-compatible endpoint)
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://integrate.api.nvidia.com/v1
GLM_MODEL=z-ai/glm-5.3

# Optional: Dedicated remediation model (Phase 4C preview)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_MODEL=moonshotai/kimi-k3